# ─── Supabase ───────────────────────────────────────────────────────────────
# Crear proyecto en https://supabase.com → Settings → API
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# ─── Mapbox (mapa de rutas en la pantalla de Viajes) ────────────────────────
# Registro gratuito en https://account.mapbox.com/ → Tokens
VITE_MAPBOX_TOKEN=pk.eyJ1Ijoixxxxxxx...

# ─── Backend API (opcional, recomendado para IA segura) ─────────────────────
# Si está definido, Gemini se llama vía /api/ai con token Supabase.
VITE_API_URL=http://localhost:3001
