# ─── Supabase ───────────────────────────────────────────────────────────────
# Crear proyecto en https://supabase.com → Settings → API
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# ─── Mapbox (mapa de rutas en la pantalla de Viajes) ────────────────────────
# Registro gratuito en https://account.mapbox.com/ → Tokens
VITE_MAPBOX_TOKEN=pk.eyJ1Ijoixxxxxxx...

# ─── Anthropic (opcional, para análisis IA de mantenimiento) ────────────────
# Se configura desde la UI (Ajustes) y se guarda en localStorage.
# Esta variable es solo para entornos de demo donde se inyecta por defecto.
# VITE_ANTHROPIC_API_KEY=sk-ant-...
