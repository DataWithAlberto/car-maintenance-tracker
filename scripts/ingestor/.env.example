# Dropbox
DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here
DROPBOX_REFRESH_TOKEN=your_refresh_token_here
DROPBOX_WATCH_FOLDER=/OBDLink          # Carpeta que monitoriza el webhook

# Supabase (usa service_role key para bypassear RLS)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ID del vehículo en Supabase al que asignar los viajes
DEFAULT_VEHICLE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Secreto para validar el webhook de Dropbox (tú lo inventas)
WEBHOOK_VERIFY_TOKEN=mi_secreto_aleatorio
